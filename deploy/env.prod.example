# Plantilla de /opt/evolutionfit/.env.prod (FUERA del repositorio, permisos 600). Sin valores reales aquí.
# Generar cada secreto en el servidor: openssl rand -base64 24 (MySQL) / openssl rand -base64 48 (JWT).
# Validar antes de arrancar: scripts/check-env-prod.sh /opt/evolutionfit/.env.prod

# Dominio y avisos de Let's Encrypt
DOMAIN=gimnasio.example.com
ACME_EMAIL=dueno@example.com

# MySQL (solo se aplican al crear el volumen por primera vez)
MYSQL_ROOT_PASSWORD=
MYSQL_USER=evolution_app
MYSQL_PASSWORD=

# Sesiones
JWT_SECRET=
JWT_EXPIRATION_MINUTES=480

# El mismo origen del dominio (https://<DOMAIN>)
CORS_ALLOWED_ORIGINS=https://gimnasio.example.com

# ADMIN inicial: solo se usa si la tabla users está vacía. Borrar la contraseña después del primer ingreso.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=Administrador
BOOTSTRAP_ADMIN_LAST_NAME=Gimnasio

# Opcionales (valores por defecto en application.yml y en REGLAS_NEGOCIO.md, sección 13)
# LOGIN_MAX_FAILURES_PER_USER=5
# LOGIN_MAX_FAILURES_PER_IP=5
# LOGIN_WINDOW=15m
# HSTS_MAX_AGE=86400   (subir a 31536000 según PUESTA_EN_MARCHA.md)
