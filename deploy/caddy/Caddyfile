# EvolutionFit en producción: un único dominio con HTTPS. Variables (de .env.prod, vía docker-compose.prod.yml):
#   DOMAIN, ACME_EMAIL; opcionales HSTS_MAX_AGE (segundos, por defecto 1 día) y CADDY_TLS (solo la prueba local
#   usa "tls internal"; en el VPS va vacía y Caddy pide el certificado a Let's Encrypt).
{
	email {$ACME_EMAIL}
	# Sin trusted_proxies: Caddy NO acepta X-Forwarded-For de los clientes; lo reescribe con la IP real de la
	# conexión antes de pasarla al backend. Si algún día se pone una CDN delante, aquí se declaran sus rangos.
}

{$DOMAIN} {
	{$CADDY_TLS}

	encode zstd gzip

	# Registro de accesos en JSON (Caddy oculta Authorization y Cookie por defecto).
	log {
		output stdout
		format json
	}

	header {
		Strict-Transport-Security "max-age={$HSTS_MAX_AGE:86400}"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# API: solo /api llega al backend (ni /actuator ni Swagger son accesibles desde fuera).
	handle /api/* {
		request_body {
			max_size 3MB
		}
		reverse_proxy backend:8080
	}

	# Rutas internas del backend: nunca desde fuera (tampoco caen en el index.html del frontend).
	@internal path /actuator /actuator/* /v3/api-docs /v3/api-docs/* /swagger-ui /swagger-ui/* /swagger-ui.html
	handle @internal {
		respond 404
	}

	# Frontend: archivos estáticos; las rutas de Angular devuelven index.html.
	handle {
		root * /srv
		# Archivos con huella en el nombre (main-XXXX.js, chunk-XXXX.js, styles-XXXX.css, media/): caché de un año.
		@hashed path_regexp hashed ^/((main|chunk|polyfills|styles)-[A-Za-z0-9_-]+\.(js|css)|media/.+)$
		@fresh not path_regexp ^/((main|chunk|polyfills|styles)-[A-Za-z0-9_-]+\.(js|css)|media/.+)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# El resto (index.html, favicon, logo) se revalida siempre: una versión nueva se ve sin limpiar caché.
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
