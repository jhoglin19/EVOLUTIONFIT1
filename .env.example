# Copia este archivo a .env y completa los valores. NO subas .env a Git (ya está en .gitignore).
# Lo leen dos cosas: Docker Compose y el backend (Spring lo carga solo al arrancar desde VS Code).
# Escribe los valores SIN comillas.

# --- MySQL ---
# Deben ser las mismas contraseñas con las que ya existe tu base de datos.
MYSQL_ROOT_PASSWORD=
MYSQL_USER=evolution_app
MYSQL_PASSWORD=

# --- Backend ---
# Obligatoria. Genera una clave larga y aleatoria, por ejemplo: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=480
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Administrador inicial: solo se crea si la tabla users está vacía.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
