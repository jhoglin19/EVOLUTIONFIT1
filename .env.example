# Copia este archivo a .env y completa los valores. NO subas .env a Git (ya está en .gitignore).
# Lo leen dos cosas: Docker Compose y el backend (Spring lo carga solo al arrancar).
# Escribe los valores SIN comillas. La explicación de cada variable está en el README ("Variables de entorno").

# --- MySQL (Docker Compose) ---
# Deben ser las mismas contraseñas con las que ya existe tu base de datos.
MYSQL_ROOT_PASSWORD=
MYSQL_USER=evolution_app
MYSQL_PASSWORD=

# Opcionales: solo si la base está en otro lugar o con otras credenciales.
# DB_URL=jdbc:mysql://localhost:3306/evolution_fit?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Bogota&useUnicode=true&characterEncoding=UTF-8
# DB_USERNAME=
# DB_PASSWORD=

# --- Backend ---
# Obligatoria, mínimo 32 caracteres. Genera una clave larga y aleatoria: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=480
CORS_ALLOWED_ORIGINS=http://localhost:4200
# SERVER_PORT=8080

# Administrador inicial: solo se crea si la tabla users está vacía. La contraseña debe tener al menos 8
# caracteres; después del primer ingreso, cámbiala en la aplicación y borra BOOTSTRAP_ADMIN_PASSWORD de aquí.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_FIRST_NAME=Administrador
# BOOTSTRAP_ADMIN_LAST_NAME=Sistema

# --- Reglas configurables (opcionales; estos son los valores por defecto) ---
# MEMBERSHIP_EXPIRY_WARNING_DAYS=5
# MEMBERSHIP_MAX_FREEZE_DAYS=30
# MEMBERSHIP_RECENTLY_EXPIRED_DAYS=15
# RECEIPT_PAPER_SIZE=A5
# CASH_CLOSING_TIME=22:00
# REPORTS_MAX_RANGE_DAYS=366

# No definas APP_E2E_ENABLED: es solo para las pruebas de punta a punta (carpeta e2e/).
